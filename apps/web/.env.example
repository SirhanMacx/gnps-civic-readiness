# GNPS Civic Readiness Portal — apps/web env file.
# Copy to apps/web/.env.local for local dev. Production deployments load
# these from the docker-compose / Caddy environment, not from this file.

# ── Database (Postgres connection string) ─────────────────────────────────
DATABASE_URL=postgres://civicseal:civicseal@localhost:5432/civicseal

# ── Auth ───────────────────────────────────────────────────────────────────
# 32+ random bytes. Rotating signs every staff member out next time the
# JWT is verified.
SESSION_SECRET=change-me-32-bytes-min
PUBLIC_APP_URL=http://localhost:5173

# ── Email (SMTP) ───────────────────────────────────────────────────────────
# Used for: staff sign-in magic links, supervisor confirmation, student
# progress reports. Leave SMTP_HOST blank to disable email sending — the
# rest of the app keeps working; sends become no-ops with a console warning.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="GNPS Civic Readiness <civicseal@greatneck.k12.ny.us>"

# ── Confirmation-link signing ──────────────────────────────────────────────
# Used by both supervisor confirm tokens and signed evidence URLs. 32+ random
# chars. Rotating invalidates pending supervisor links and any signed
# evidence URLs already in flight.
SIGNED_LINK_SECRET=change-me-32-bytes-min

# ── Storage ────────────────────────────────────────────────────────────────
# fs (default) — local filesystem at EVIDENCE_DIR
# s3           — S3-compatible (also requires @aws-sdk/client-s3 install)
STORAGE_BACKEND=fs
EVIDENCE_DIR=.evidence-data

# When STORAGE_BACKEND=s3:
# S3_BUCKET=
# S3_PREFIX=
# AWS_REGION=us-east-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# ── DEPRECATED — these env vars were used by the SaaS deployment ───────────
# The migration from Supabase + Resend removed all references to these.
# Keep them here for documentation only — they're no longer read by the app.
# PUBLIC_SUPABASE_URL= (deprecated)
# PUBLIC_SUPABASE_ANON_KEY= (deprecated)
# SUPABASE_SERVICE_ROLE_KEY= (deprecated)
# RESEND_API_KEY= (deprecated)
