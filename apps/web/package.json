{
  "name": "@gnps-civic/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "node -e \"const fs=require('fs');const p='../../scripts/sync-vendored.mjs';if(fs.existsSync(p)){require('child_process').execSync('node '+p,{stdio:'inherit'})}else{console.log('vendored sync skipped (running outside monorepo)')}\""
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-vercel": "^5.5.2",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.3.15",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "jose": "^6.2.3",
    "nodemailer": "^8.0.7",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  }
}
