# ────────────────────────────────────────────────────────────────────────────
# Self-hosted deployment env file. Copy to .env at the repo root and fill in.
# Used by docker-compose.yml. NEVER commit .env to git.
# ────────────────────────────────────────────────────────────────────────────

# ── Public-facing domain ───────────────────────────────────────────────────
# DNS A or AAAA record for this domain MUST point to the public IP of this
# server before you run `docker compose up`. Caddy will fail to obtain an
# SSL certificate otherwise.
CIVICSEAL_DOMAIN=civicseal.example.k12.ny.us

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=civicseal
POSTGRES_USER=civicseal
# Generate with `openssl rand -base64 32` — 32+ chars
POSTGRES_PASSWORD=replace-with-strong-random-password

# ── Auth + signing ─────────────────────────────────────────────────────────
# Both must be 32+ characters of random data.
# Rotate periodically. Rotating SESSION_SECRET will sign all current users out.
# Generate each with: openssl rand -hex 32
SESSION_SECRET=replace-with-32-or-more-random-chars
SIGNED_LINK_SECRET=replace-with-32-or-more-random-chars

# ── SMTP — district mail server ────────────────────────────────────────────
# Used for: supervisor confirmation emails, student progress reports, staff
# magic-link sign-in. If left blank, those emails will gracefully no-op
# (the app still works; users just won't receive automated mail).
SMTP_HOST=smtp.example.k12.ny.us
SMTP_PORT=587
SMTP_USER=civicseal
SMTP_PASS=replace-with-smtp-password
SMTP_SECURE=false
EMAIL_FROM="GNPS Civic Readiness <civicseal@example.k12.ny.us>"

# ── Storage ────────────────────────────────────────────────────────────────
# fs   = local filesystem at EVIDENCE_DIR (default; persisted via Docker volume)
# s3   = S3-compatible object store (set S3_BUCKET, S3_REGION, S3_ACCESS_KEY,
#        S3_SECRET_KEY, optional S3_ENDPOINT)
STORAGE_BACKEND=fs
# EVIDENCE_DIR is set by docker-compose.yml to /app/evidence-data inside the container.
