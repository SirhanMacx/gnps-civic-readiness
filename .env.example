# Copy to apps/web/.env.local and fill in values from your Supabase project.
# Do NOT commit .env.local — it contains secrets.

# Public-safe keys (exposed to the browser by SvelteKit's $env/static/public).
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only secrets ($env/static/private). Service role bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Phase 2 additions (not required in Phase 1):
# RESEND_API_KEY=re_...
# EMAIL_FROM="GNPS Civic Readiness <civicseal-gnps@resend.dev>"
# SIGNED_LINK_SECRET=change-me-32-bytes-min
# PUBLIC_APP_URL=http://localhost:5173
